# Production configuration for docker-compose.prod.yml. Copy to .env.production, fill in,
# `chmod 600`, and keep it out of git. Prefer injecting these from a secret manager.
# Generate secrets with: python -c "import secrets;print(secrets.token_urlsafe(48))"

# ---- deployment
GHCR_OWNER=                      # lower-case GitHub owner of the images (ghcr.io/<owner>/…)
REPINTEL_VERSION=                # release tag to run, e.g. 0.9.0
REPINTEL_ENV=production          # staging on the preproduction server
REPINTEL_DOMAIN=                 # AynPulse, e.g. app.aynpulse.com (DNS A/AAAA record → this host)
SCANNER_DOMAIN=                  # Scanner, e.g. scanner.aynpulse.com (DNS A/AAAA → this host)
ACME_EMAIL=                      # Let's Encrypt account e-mail
API_WORKERS=3
BROWSER_MAX_CONTEXTS=2

# ---- datastores (only migrate gets the owner password)
POSTGRES_PASSWORD=
REPINTEL_OWNER_DB_PASSWORD=
REPINTEL_APP_DB_PASSWORD=
REDIS_PASSWORD=

# ---- application secrets
REPINTEL_JWT_SECRET=
REPINTEL_ENCRYPTION_KEYS=        # Fernet key(s), comma-separated, newest first
REPINTEL_METRICS_TOKEN=          # bearer token for /metrics (empty = disabled)
REPINTEL_SENTRY_DSN=             # optional error tracking (EU region recommended)

# ---- e-mail (Brevo is required in production)
REPINTEL_EMAIL_PROVIDER=brevo
REPINTEL_BREVO_API_KEY=
REPINTEL_EMAIL_FROM_ADDRESS=
REPINTEL_EMAIL_FROM_NAME=AynPulse

# ---- collection and AI
REPINTEL_SERPER_API_KEY=
REPINTEL_APIFY_TOKEN=            # third-party provider; also set a spending limit in Apify
REPINTEL_YOUTUBE_API_KEY=        # YouTube Data API v3, key restricted to that API
REPINTEL_CRAWLER_USER_AGENT=AynPulseBot/1.0 (+https://app.aynpulse.com/bot)   # page served by the app
REPINTEL_OPENAI_API_KEY=
REPINTEL_NLP_MODELS=[]           # JSON list of model ids you chose
REPINTEL_SCANNER_EXTRACTION_MODEL=   # Scanner: vision model reading screenshots (empty = off)
REPINTEL_SCANNER_EXTRACTION_MIN_CONFIDENCE=0.65
REPINTEL_NLP_ARBITER_MODEL=

# ---- plans and billing (manual invoicing)
REPINTEL_DEFAULT_PLAN=trial
REPINTEL_TRIAL_DAYS=14
REPINTEL_PLATFORM_NOTIFY_EMAILS=[]          # JSON list: who receives plan-change requests
REPINTEL_BILLING_INVOICE_PREFIX=FAC
REPINTEL_BILLING_PAYMENT_TERMS_DAYS=30
REPINTEL_BILLING_DEFAULT_TAX_RATE=19.0      # confirm with your accountant
REPINTEL_BILLING_SELLER_NAME=
REPINTEL_BILLING_SELLER_ADDRESS=
REPINTEL_BILLING_SELLER_RC=
REPINTEL_BILLING_SELLER_NIF=
REPINTEL_BILLING_SELLER_NIS=
REPINTEL_BILLING_SELLER_ARTICLE_IMPOSITION=
REPINTEL_BILLING_SELLER_BANK=               # RIB / IBAN printed on invoices
REPINTEL_BILLING_SELLER_EMAIL=
REPINTEL_BILLING_SELLER_PHONE=
REPINTEL_RETENTION_MAX_DAYS=730
REPINTEL_ADMIN_REQUIRE_MFA=true

# ---- AynPulse Scanner (start the stack with --profile scanner when enabled) ----
REPINTEL_SCANNER_ENABLED=false
# Private S3-compatible bucket for Scanner screenshots (required once Scanner is enabled).
# Scaleway Object Storage, Paris: endpoint https://s3.fr-par.scw.cloud, region fr-par
REPINTEL_STORAGE_BACKEND=s3
REPINTEL_STORAGE_ENDPOINT_URL=
REPINTEL_STORAGE_REGION=
REPINTEL_STORAGE_BUCKET=
REPINTEL_STORAGE_ACCESS_KEY=
REPINTEL_STORAGE_SECRET_KEY=
# Built-in browser (scanner-browser, `--profile scanner`). Served on the Scanner domain at
# /api/v1/scanner/browser/ws (same origin: leave PUBLIC_URL empty). Agents sign in there to the
# dedicated social-media accounts; their cookies are stored encrypted, never their passwords.
REPINTEL_SCANNER_BROWSER_ENABLED=false
REPINTEL_SCANNER_BROWSER_PUBLIC_URL=
REPINTEL_SCANNER_BROWSER_MAX_SESSIONS=4
REPINTEL_SCANNER_BROWSER_IDLE_SECONDS=600
