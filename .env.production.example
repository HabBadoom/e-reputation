# Production configuration for docker-compose.prod.yml. Copy to .env.production, fill in,
# `chmod 600`, and keep it out of git. Prefer injecting these from a secret manager.
# Generate secrets with: python -c "import secrets;print(secrets.token_urlsafe(48))"

# ---- deployment
GHCR_OWNER=                      # lower-case GitHub owner of the images (ghcr.io/<owner>/…)
REPINTEL_VERSION=                # release tag to run, e.g. 0.9.0
REPINTEL_DOMAIN=                 # e.g. app.example.dz (DNS A/AAAA record → this host)
ACME_EMAIL=                      # Let's Encrypt account e-mail
API_WORKERS=3
BROWSER_MAX_CONTEXTS=2

# ---- datastores (only migrate gets the owner password)
POSTGRES_PASSWORD=
REPINTEL_OWNER_DB_PASSWORD=
REPINTEL_APP_DB_PASSWORD=
REDIS_PASSWORD=

# ---- application secrets
REPINTEL_JWT_SECRET=
REPINTEL_ENCRYPTION_KEYS=        # Fernet key(s), comma-separated, newest first
REPINTEL_METRICS_TOKEN=          # bearer token for /metrics (empty = disabled)
REPINTEL_SENTRY_DSN=             # optional error tracking (EU region recommended)

# ---- e-mail (Brevo is required in production)
REPINTEL_EMAIL_PROVIDER=brevo
REPINTEL_BREVO_API_KEY=
REPINTEL_EMAIL_FROM_ADDRESS=
REPINTEL_EMAIL_FROM_NAME=RepIntel

# ---- collection and AI
REPINTEL_SERPER_API_KEY=
REPINTEL_CRAWLER_USER_AGENT=     # honest bot name + URL of a page explaining it
REPINTEL_OPENAI_API_KEY=
REPINTEL_NLP_MODELS=[]           # JSON list of model ids you chose
REPINTEL_NLP_ARBITER_MODEL=

# ---- plans and billing (manual invoicing)
REPINTEL_DEFAULT_PLAN=trial
REPINTEL_TRIAL_DAYS=14
REPINTEL_PLATFORM_NOTIFY_EMAILS=[]          # JSON list: who receives plan-change requests
REPINTEL_BILLING_INVOICE_PREFIX=FAC
REPINTEL_BILLING_PAYMENT_TERMS_DAYS=30
REPINTEL_BILLING_DEFAULT_TAX_RATE=19.0      # confirm with your accountant
REPINTEL_BILLING_SELLER_NAME=
REPINTEL_BILLING_SELLER_ADDRESS=
REPINTEL_BILLING_SELLER_RC=
REPINTEL_BILLING_SELLER_NIF=
REPINTEL_BILLING_SELLER_NIS=
REPINTEL_BILLING_SELLER_ARTICLE_IMPOSITION=
REPINTEL_BILLING_SELLER_BANK=               # RIB / IBAN printed on invoices
REPINTEL_BILLING_SELLER_EMAIL=
REPINTEL_BILLING_SELLER_PHONE=
REPINTEL_RETENTION_MAX_DAYS=730
REPINTEL_ADMIN_REQUIRE_MFA=true
