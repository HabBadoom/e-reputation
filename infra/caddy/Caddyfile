{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# AynPulse (clients and platform administrators)
{$REPINTEL_DOMAIN} {
	encode zstd gzip
	import security_headers

	# The metrics endpoint is scraped from the private network, never through the edge.
	@metrics path /metrics
	respond @metrics 404

	@api path /api/* /healthz /readyz
	reverse_proxy @api api:8000 {
		header_up X-Forwarded-Proto {scheme}
	}

	reverse_proxy web:3000

	log {
		output stdout
		format json
	}
}

# AynPulse Scanner (collection agents). Containers started with --profile scanner.
{$SCANNER_DOMAIN} {
	encode zstd gzip
	import security_headers

	@metrics path /metrics
	respond @metrics 404

	# Built-in browser: WebSocket to scanner-browser, reached over the internal scanner-edge
	# network only. The service checks the Origin against REPINTEL_SCANNER_BASE_URL.
	@browser path /api/v1/scanner/browser/ws
	reverse_proxy @browser scanner-browser:8100 {
		header_up X-Forwarded-Proto {scheme}
	}

	# Only the Scanner part of the API is reachable from this domain.
	@scanner_api path /api/v1/scanner/*
	reverse_proxy @scanner_api api:8000 {
		header_up X-Forwarded-Proto {scheme}
	}

	# respond runs before reverse_proxy, so the Scanner routes are excluded explicitly.
	@other_api {
		path /api/* /healthz /readyz
		not path /api/v1/scanner/*
	}
	respond @other_api 404

	reverse_proxy scanner-web:3001

	log {
		output stdout
		format json
	}
}
