# Copy to .env for local development. Never commit .env.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
REPINTEL_JWT_SECRET=
# Encrypts MFA secrets at rest. Generate with:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
REPINTEL_ENCRYPTION_KEYS=

# Email. Leave EMAIL_PROVIDER=console to print emails (with their links) in the API logs.
# To send real emails through Brevo: set brevo, paste your API key (Brevo > SMTP & API >
# API keys) and use a sender address verified in Brevo (Senders, domains & IPs).
REPINTEL_EMAIL_PROVIDER=console
REPINTEL_BREVO_API_KEY=
REPINTEL_EMAIL_FROM_ADDRESS=no-reply@example.com
REPINTEL_EMAIL_FROM_NAME=RepIntel

# Web search (Serper.dev > Dashboard > API key). Empty = search disabled; RSS still works.
REPINTEL_SERPER_API_KEY=
# Identify the crawler honestly; put a page explaining it and a contact address here.
REPINTEL_CRAWLER_USER_AGENT=RepIntelBot/0.1 (+https://example.com/bot)
REPINTEL_SERPER_API_KEY=<votre clé : serper.dev → Dashboard → API key>
REPINTEL_CRAWLER_USER_AGENT=RepIntelBot/0.1 (+https://votre-site/bot)

# Language analysis (OpenAI). Leave the key empty to disable AI analysis (the deterministic
# Darija/Arabizi layer still runs). Model ids are your choice; no default is hardcoded.
REPINTEL_OPENAI_API_KEY=
# JSON list, cycled over the annotators, e.g. ["<model-a>","<model-b>"]
REPINTEL_NLP_MODELS=[]
REPINTEL_NLP_ARBITER_MODEL=
